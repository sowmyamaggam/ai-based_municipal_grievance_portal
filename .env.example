# Required for persistence and credentials authentication
MONGODB_URI=
AUTH_SECRET=generate-a-long-random-secret

# Complaints are saved before AI analysis; provider failures do not discard reports.
# Never add a real key to this tracked template.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Private FastAPI services; never expose these URLs to the browser.
# The Next.js server sends uploaded images here; this URL is never exposed to the browser.
ML_IMAGE_MODEL_URL=http://127.0.0.1:8000/predict
ML_WORK_TYPE_MODEL_URL=http://127.0.0.1:8000/classify-work-type
# Set this in production; the same value must be configured for ml-service.
ML_SERVICE_TOKEN=

# Optional Cloudinary credentials. Local private storage is used only during development when omitted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed` to create or update the first privileged account.
SEED_ADMIN_PHONE=+919876543210
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=CivicGuard Administrator

# Optional duplicate-detection tuning (in metres and 0-1 score).
DUPLICATE_DISTANCE_METERS=100
DUPLICATE_SCORE_THRESHOLD=0.7
