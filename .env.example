# Required for persistence and credentials authentication
MONGODB_URI= 
AUTH_SECRET=generate-a-long-random-secret

# Gemini is optional: submissions are stored with analysis PENDING if omitted.
# Never add a real key to this tracked template.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Fallback used automatically only if the primary model has been retired.
# `gemini-2.5-flash` is retained as the primary required by the project brief;
# this newer model keeps production AI working for API keys where 2.5 is gone.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional Cloudinary credentials. Local data URLs are used during development when omitted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed` to create or update the first privileged account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=CivicGuard Administrator

# Optional duplicate-detection tuning (in metres and 0-1 score).
DUPLICATE_DISTANCE_METERS=100
DUPLICATE_SCORE_THRESHOLD=0.7
